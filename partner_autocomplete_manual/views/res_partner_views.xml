<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_form_domain_autocomplete" model="ir.ui.view">
        <field name="name">res.partner.form.domain.autocomplete</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_enrich_from_domain"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-globe"
                    invisible="not website"
                    help="Extract company name, VAT, phone, address and logo from the domain website"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Autocomplete</span>
                        <span class="o_stat_text">from Web</span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//field[@name='website']" position="after">
                <button
                    name="action_enrich_from_domain"
                    type="object"
                    icon="fa-magic"
                    title="Extract tax and contact data from this website"
                    class="btn-link ps-0 pt-0 pb-0"
                    invisible="not website"
                />
                <field
                    name="enrich_status"
                    widget="badge"
                    decoration-success="enrich_status == 'done'"
                    decoration-warning="enrich_status == 'pending'"
                    decoration-danger="enrich_status == 'error'"
                    invisible="not enrich_status"
                />
                <field
                    name="enrich_error"
                    invisible="not enrich_error"
                    class="text-danger"
                />
            </xpath>
        </field>
    </record>

    <record id="action_server_partner_enrich_from_domain" model="ir.actions.server">
        <field name="name">Autocomplete data from Web (No IAP)</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="binding_model_id" ref="base.model_res_partner" />
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]" />
        <field name="state">code</field>
        <field name="code">
if records:
    action = records.action_enrich_from_domain()
        </field>
    </record>
</odoo>
